<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.arashe023.Gisheh</id>
  <name>Gisheh</name>
  <summary>Browse and track movies, shows and anime</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      Gisheh is a native GNOME application for exploring and tracking movies,
      television shows and anime with TMDB metadata and Simkl watch history.
    </p>
  </description>
  <launchable type="desktop-id">io.github.arashe023.Gisheh.desktop</launchable>
  <provides>
    <binary>gisheh</binary>
  </provides>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
  </categories>
  <url type="homepage">https://github.com/arashe023/Gisheh</url>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@PROJECT_VERSION@" date="@RELEASE_DATE@"/>
    <release version="1.3.0" date="2026-08-08"/>
  </releases>
</component>
