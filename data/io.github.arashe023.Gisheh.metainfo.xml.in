<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.arashe023.Gisheh</id>
  <name>Gisheh</name>
  <summary>Browse and track movies, shows and anime</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      Gisheh is a native GNOME application for exploring and tracking movies,
      television shows and anime with TMDB metadata and Simkl watch history.
    </p>
  </description>
  <launchable type="desktop-id">io.github.arashe023.Gisheh.desktop</launchable>
  <provides>
    <binary>gisheh</binary>
  </provides>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
  </categories>
  <url type="homepage">https://github.com/arashe023/Gisheh</url>
  <url type="bugtracker">https://github.com/arashe023/Gisheh/issues</url>
  <url type="help">https://github.com/arashe023/Gisheh/blob/main/README.md</url>
  <url type="vcs-browser">https://github.com/arashe023/Gisheh</url>
  <url type="contribute">https://github.com/arashe023/Gisheh/blob/main/CONTRIBUTING.md</url>
  <url type="contact">https://github.com/arashe023/Gisheh/issues</url>
  <developer id="io.github.arashe023">
    <name>arashe023</name>
  </developer>
  <screenshots>
    <screenshot type="default">
      <caption>Manage a private local library</caption>
      <image>https://raw.githubusercontent.com/arashe023/Gisheh/main/data/screenshots/local-library.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@PROJECT_VERSION@" date="@RELEASE_DATE@" type="development">
      <description>
        <p>A release candidate with a redesigned profile, system-language layout,
        independent TMDB language preferences and improved library recovery.</p>
      </description>
    </release>
    <release version="1.4.0" date="2026-09-12"/>
    <release version="1.3.0" date="2026-08-08"/>
  </releases>
</component>
